# ==========================================
# PUBLIC URLS (Change these to your Server's Public IP or Domain)
# ==========================================
# Example: http://198.51.100.10
FRONTEND_PUBLIC_URL=http://localhost
# Example: http://198.51.100.10:8000
GATEWAY_PUBLIC_URL=http://localhost:8000

# ==========================================
# API KEYS & SECRETS
# ==========================================
# Firebase
VITE_FIREBASE_APIKEY=your_firebase_api_key

# Groq (Used by Resume, Interview, Roadmap)
GROQ_API_KEY=your_groq_api_key

# YouTube (Used by Roadmap)
YOUTUBE_API_KEY=your_youtube_api_key

# Razorpay (Used by Billing & Frontend)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
